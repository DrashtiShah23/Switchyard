# Switchyard local configuration — names and placeholders only.
# Copy to .env for local overrides. Never commit real secrets.

SWITCHYARD_ENV=local
SWITCHYARD_LOG_LEVEL=INFO

# Demo authentication (comma-separated api_key:actor pairs)
# Example: SWITCHYARD_API_KEYS=dev-key:alice,ops-key:platform
SWITCHYARD_API_KEYS=replace-me:local-developer

# SQLite persistence (repository interface; not PostgreSQL)
SWITCHYARD_DATABASE_URL=sqlite:///./data/switchyard.db

# Terraform execution mode: mock | local | aws
SWITCHYARD_TERRAFORM_MODE=mock

# Optional: path for saved plan artifacts
SWITCHYARD_ARTIFACT_DIR=./artifacts

# AWS (only for explicitly triggered integration / deploy workflows)
# AWS_PROFILE=switchyard-sandbox
# AWS_REGION=us-west-2
# SWITCHYARD_TF_STATE_BUCKET=
# SWITCHYARD_HOSTED_ZONE_ID=
